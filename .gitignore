# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# static-export staging (npm run build:pages moves server-only sources here
# for the duration of the build and always moves them back)
/.static-export-hold/

# production
/build

# misc
.DS_Store
Thumbs.db
desktop.ini
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (never commit real values; the template is safe to commit)
.env*
.env*.local
!.env.example

# local inquiry sink (development only)
/.data/

# screenshot capture artifacts (keep the PNG evidence and final-gate.log)
screenshots/**/server*.log
screenshots/**/*.pid
screenshots/**/build.log
screenshots/**/metrics.json

# ad-hoc capture runs: machine-local, large and regenerable. Curated evidence
# stays tracked under screenshots/{final,live,phase*,visual-gate}.
/screenshots/local/
/screenshots/theme-audit/

# playwright
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# agent / language-server state (Serena MCP)
/.serena/
