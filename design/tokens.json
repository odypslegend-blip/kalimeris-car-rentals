{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "brand": "Kalimeris Car Rentals",
  "status": "proposed-unapproved",
  "colors": {
    "background": "#F5F2EA",
    "surface": "#FFFFFF",
    "surfaceElevated": "#ECE7DC",
    "ink": "#0E1720",
    "textMuted": "#525E66",
    "brand": "#087F78",
    "brandHover": "#066660",
    "brandSubtle": "#E4F2EF",
    "accentOrange": "#FF693B",
    "accentYellow": "#F4C95D",
    "border": "#DDE2DF",
    "hairline": "#E6E4DC",
    "error": "#B42318"
  },
  "font": {
    "family": "Syne",
    "subsets": [
      "latin",
      "greek"
    ],
    "weights": [
      400,
      500,
      600,
      700
    ]
  },
  "maxWidth": "1240px",
  "gutter": {
    "mobile": "20px",
    "tablet": "32px",
    "desktop": "40px"
  },
  "spacing": {
    "1": "4px",
    "2": "8px",
    "3": "12px",
    "4": "16px",
    "6": "24px",
    "8": "32px",
    "12": "48px",
    "16": "64px"
  },
  "radius": {
    "input": "9px",
    "button": "9px",
    "card": "14px",
    "hero": "18px"
  },
  "shadow": {
    "card": "0 10px 28px rgba(14,23,32,.06)"
  },
  "motion": {
    "fast": 180,
    "normal": 220,
    "slow": 300,
    "ease": "cubic-bezier(.2,.8,.2,1)"
  },
  "breakpoints": {
    "mobile": "375px",
    "tablet": "768px",
    "desktop": "1024px",
    "wide": "1440px"
  }
}