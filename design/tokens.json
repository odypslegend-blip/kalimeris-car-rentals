{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "brand": "Kalimeris Car Rentals",
  "status": "proposed-unapproved",
  "colors": {
    "background": "#F7F8F7",
    "surface": "#FFFFFF",
    "ink": "#0E1720",
    "textMuted": "#58646B",
    "brand": "#087F78",
    "brandHover": "#076861",
    "brandSubtle": "#E7F5F2",
    "border": "#E2E8E7",
    "hairline": "#EDF0F0",
    "error": "#B42318"
  },
  "font": {
    "family": "Inter",
    "subsets": [
      "latin",
      "greek"
    ],
    "weights": [
      400,
      500,
      600,
      700,
      800
    ]
  },
  "maxWidth": "1240px",
  "gutter": {
    "mobile": "20px",
    "tablet": "32px",
    "desktop": "40px"
  },
  "spacing": {
    "1": "4px",
    "2": "8px",
    "3": "12px",
    "4": "16px",
    "6": "24px",
    "8": "32px",
    "12": "48px",
    "16": "64px"
  },
  "radius": {
    "input": "9px",
    "button": "9px",
    "card": "14px",
    "hero": "18px"
  },
  "shadow": {
    "card": "0 8px 25px rgba(14,23,32,.05)"
  },
  "motion": {
    "fast": 140,
    "normal": 190,
    "slow": 250,
    "ease": "cubic-bezier(.2,.8,.2,1)"
  },
  "breakpoints": {
    "mobile": "375px",
    "tablet": "768px",
    "desktop": "1024px",
    "wide": "1440px"
  }
}