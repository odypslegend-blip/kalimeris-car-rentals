# Copy to `.env.local` (never commit) and fill in real values before launch.
# Nothing here is a real secret.

# ---------------------------------------------------------------------------
# Public canonical origin
# ---------------------------------------------------------------------------
# Used for metadata, canonical URLs, robots and sitemap. No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Inquiry delivery — the form reports failure until one of these is configured
# ---------------------------------------------------------------------------
# Delivery priority when several are set: Resend → webhook → dev file.
# With none of them configured, POST /api/inquiries answers 503
# `not_configured` and the UI says so instead of faking a success.

# 1) Transactional email via Resend (https://resend.com). Plain-text only.
#    All three values are required for the Resend transport to activate.
RESEND_API_KEY=
#    A verified sender on your Resend domain, e.g. "Kalimeris <requests@example.com>".
INQUIRY_FROM_EMAIL=
#    The owner inbox that receives quote requests.
INQUIRY_TO_EMAIL=

# 2) Owner webhook. Receives a JSON POST with the `x-kalimeris-inquiry` header.
#    Non-2xx responses are treated as a delivery failure.
INQUIRY_WEBHOOK_URL=
#    Optional shared secret. When set it is sent as the `x-kalimeris-inquiry`
#    header value; when empty the header is `1`.
INQUIRY_WEBHOOK_SECRET=

# 3) Development-only file sink. Appends JSON lines to `.data/inquiries.jsonl`.
#    Requires INQUIRY_DEV_SINK=1 AND NODE_ENV !== "production"; it is ignored in
#    a production build so a deploy can never silently "succeed" into a file.
#    For a production-mode smoke test, set INQUIRY_WEBHOOK_URL instead.
INQUIRY_DEV_SINK=1

# ---------------------------------------------------------------------------
# Abuse limits
# ---------------------------------------------------------------------------
# Sliding-window limit per IP for POST /api/inquiries (default 5).
# Per server instance only — use Redis/Upstash for multi-instance deployments.
INQUIRY_RATE_LIMIT_PER_HOUR=5

# Global sliding-window backstop across all callers for POST /api/inquiries
# (default 120). Bounds a flood that rotates spoofed x-forwarded-for values.
# Also per server instance; keep it well above the per-IP limit.
INQUIRY_GLOBAL_RATE_LIMIT_PER_HOUR=120
